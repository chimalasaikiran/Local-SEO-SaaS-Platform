# Server Configuration
PORT=4000
NODE_ENV=development

# Background Workers
WORKER_CONCURRENCY=5

# Geo Data Providers (Open-Source/Self-Hosted)
GEO_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# AI Preparation
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3

# Database Configuration (PostgreSQL / Neon)
# The DATABASE_URL is standard for Neon. It contains all credentials.
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-withered-base-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback individual credentials (optional, if you don't use DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=localseo

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
